{
	"name": "oxygen-monorepo",
	"private": true,
	"version": "0.2.0",
	"description": "Oxygen \u2014 a Bedrock-faithful particle IDE",
	"license": "GPL-3.0-or-later",
	"author": "dev-hydrogen",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "pnpm --filter @oxygen/web dev",
		"build": "pnpm -r --filter=!./vendor/** build",
		"build:vendor": "pnpm --filter molangjs build && pnpm --filter wintersky build",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "pnpm -r typecheck",
		"metadata": "pnpm --filter @oxygen/metadata fetch",
		"testpack": "pnpm --filter @oxygen/testpack generate",
		"test:vscode": "pnpm --filter oxygen-particle-editor build && node apps/vscode/test/run.mjs",
		"test:webview-sync": "pnpm --filter oxygen-particle-editor build && node tools/vscode-webview-test.mjs",
		"test:soak": "pnpm --filter oxygen-particle-editor build && node tools/soak-test.mjs",
		"test:desktop": "pnpm --filter @oxygen/desktop build && node tools/desktop-test.mjs",
		"desktop": "pnpm --filter @oxygen/desktop start",
		"package:vscode": "pnpm --filter oxygen-particle-editor package",
		"package:desktop": "pnpm --filter @oxygen/desktop package",
		"package:mcp": "pnpm --filter @oxygen/mcp package",
		"test:game-loop": "pnpm --filter @oxygen/desktop build && node tools/game-loop-test.mjs",
		"icons": "node tools/icons.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/node": "^24.0.0",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"vitest": "^5.0.5"
	}
}
