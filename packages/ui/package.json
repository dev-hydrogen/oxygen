{
	"name": "@oxygen/ui",
	"version": "0.3.0",
	"private": true,
	"type": "module",
	"description": "Oxygen editor UI: Svelte 5 workspace, panels, field editors and viewport (shared by web, VS Code and desktop)",
	"svelte": "./src/index.ts",
	"main": "./src/index.ts",
	"exports": {
		".": {
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./lib/*": "./src/lib/*.ts",
		"./styles/*": "./src/styles/*",
		"./static/*": "./static/*"
	},
	"scripts": {
		"typecheck": "cd ../../apps/web && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@fontsource-variable/recursive": "^5.3.0",
		"@lezer/highlight": "^1.2.5",
		"@oxygen/effect": "workspace:*",
		"@oxygen/format": "workspace:*",
		"@oxygen/lang": "workspace:*",
		"@oxygen/metadata": "workspace:*",
		"@oxygen/scene": "workspace:*",
		"dockview-core": "^8.6.0",
		"fflate": "^0.8.2",
		"jsonc-parser": "^3.3.1",
		"mediabunny": "^1.62.1",
		"molangjs": "workspace:*",
		"three": "^0.186.1",
		"uplot": "^1.6.32",
		"wintersky": "workspace:*"
	},
	"devDependencies": {
		"@types/three": "^0.186.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7"
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	}
}
